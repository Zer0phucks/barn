[Unit]
Description=BARN VPT Worker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/barn/scan
EnvironmentFile=%h/barn/scan/.worker.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/barn/scan/.venv/bin/python %h/barn/scan/webgui/app.py --skip-check
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
